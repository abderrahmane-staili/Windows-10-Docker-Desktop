    {
      "parameters": {
        "jsCode": "\nconst raw = $input.first().json.output;\n\nfunction extractList(text, start, endMarkers = []) {\n  const startIndex = text.indexOf(start);\n  if (startIndex === -1) return [];\n\n  let section = text.slice(startIndex + start.length);\n\n  const positions = endMarkers\n    .map(marker => section.indexOf(marker))\n    .filter(index => index !== -1);\n\n  if (positions.length) {\n    section = section.slice(0, Math.min(...positions));\n  }\n\n  return section\n    .split(\"\\n\")\n    .map(line => line.replace(/^\\s*-\\s*/, \"\").trim())\n    .filter(line => line && !line.endsWith(\":\"));\n}\n\nfunction extractValue(text, label) {\n  const regex = new RegExp(\n    `-\\\\s*${label}:\\\\s*(.+)`,\n    \"i\"\n  );\n  return text.match(regex)?.[1]?.trim() ?? \"\";\n}\n\nconst scoreMatch = raw.match(\n  /Match score\\s*\\(0-100\\)\\s*[\\s\\S]*?-\\s*(\\d+)/i\n);\n\nconst result = {\n  job_title: extractValue(raw, \"Job title\"),\n  required_skills: extractList(\n    raw,\n    \"Required skills:\",\n    [\"Preferred skills:\", \"Responsibilities:\"]\n  ),\n  preferred_skills: extractList(\n    raw,\n    \"Preferred skills:\",\n    [\"Responsibilities:\", \"Experience:\"]\n  ),\n  matching_skills: extractList(\n    raw,\n    \"Matching skills (explicitly supported by the CV)\",\n    [\"Missing or unverified skills\", \"Relevant projects\"]\n  ),\n  missing_skills: extractList(\n    raw,\n    \"Missing or unverified skills\",\n    [\"Relevant projects\", \"Match score\"]\n  ),\n  relevant_projects: extractList(\n    raw,\n    \"Relevant projects (from CV)\",\n    [\"Match score\"]\n  ),\n  score: scoreMatch ? Number(scoreMatch[1]) : null,\n  recommendation: extractValue(raw, \"Recommendation\"),\n  experience: extractValue(raw, \"Experience\"),\n  education: extractValue(raw, \"Education\"),\n  explanation: extractList(\n    raw,\n    \"Explanation and evidence\",\n    [\"Suggested next steps\", \"Note:\"]\n  ).join(\" \"),\n  interview_questions: extractList(\n    raw,\n    \"Suggested next steps / questions for interview\",\n    [\"Note:\"]\n  )\n};\n\nreturn [{ json: result }];\n"
      },
